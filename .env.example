# --- Nazwa aplikacji (widoczna w tekstach interfejsu) ---
NEXT_PUBLIC_APP_NAME=DeliveryRooms
NEXT_PUBLIC_SITE_URL=https://twoja-domena.vercel.app

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# NIGDY nie dodawaj prefiksu NEXT_PUBLIC_ do poniższego — musi być dostępny
# tylko po stronie serwera:
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Resend (resend.com -> API Keys) ---
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL="DeliveryRooms <dostawy@twoja-domena.pl>"

# --- Cron (dowolny losowy ciąg, ten sam co w vercel.json nagłówku) ---
CRON_SECRET=wygeneruj-losowy-dlugi-ciag-znakow
